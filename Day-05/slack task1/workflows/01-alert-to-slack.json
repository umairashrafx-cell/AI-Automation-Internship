            },
            {
              "id": "f2",
              "name": "records",
              "value": 1284,
              "type": "number"
            },
            {
              "id": "f3",
              "name": "source",
              "value": "Airtable → Postgres",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Sample Run Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#n8n-alerts",
