      "position": [200, 0],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Slack — n8n bot"
        }
      }
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#n8n-alerts",
          "mode": "name"
        },
        "text": "=:white_check_mark: Finished — *{{ $('Sample Run Data').item.json.records }}* records processed, 0 errors.",
        "otherOptions": {
          "mrkdwn": true,
          "thread_ts": {
            "replyValues": {
              "thread_ts": "={{ $json.ts }}",
