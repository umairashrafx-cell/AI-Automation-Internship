  "connections": {
    "When clicking Execute": {
      "main": [[{ "node": "Sample Run Data", "type": "main", "index": 0 }]]
    },
    "Sample Run Data": {
      "main": [[{ "node": "Post Start", "type": "main", "index": 0 }]]
    },
    "Post Start": {
      "main": [[{ "node": "Reply In Thread", "type": "main", "index": 0 }]]
    }
