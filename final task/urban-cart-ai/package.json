{
  "name": "urban-cart-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UrbanCart AI Automation System - 24/7 grounded AI support across chat and voice, orchestrated by n8n.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node backend/src/server.ts",
    "dev": "node --watch backend/src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/setup-database.ts",
    "db:seed": "node scripts/seed-database.ts",
    "rag:ingest": "node scripts/ingest-knowledge-base.ts",
    "rag:reindex": "node scripts/ingest-knowledge-base.ts --force",
    "seed:airtable": "node scripts/sync-airtable.ts",
    "notion:publish": "node scripts/publish-notion-docs.ts",
    "test": "node --test --test-reporter=spec \"tests/*.test.ts\"",
    "test:scenarios": "node --test --test-reporter=spec tests/scenarios.test.ts",
    "verify": "node scripts/verify-setup.ts",
    "kb:generate": "node scripts/generate-knowledge-base.ts",
    "db:reset": "node scripts/reset-database.ts",
    "demo:setup": "npm run db:reset && npm run kb:generate && npm run rag:ingest",
    "n8n:generate": "node scripts/generate-n8n-workflows.ts",
    "drive:sync": "node scripts/sync-google-drive.ts",
    "test:unit": "node --test --test-reporter=spec tests/unit.test.ts",
    "test:api": "node --test --test-reporter=spec tests/api.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "mammoth": "^1.8.0",
    "pg": "^8.13.1",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "docx": "^9.7.1",
    "pdfkit": "^0.20.2",
    "typescript": "^7.0.2"
  }
}
