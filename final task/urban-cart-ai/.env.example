# =============================================================================
# UrbanCart AI Automation System - environment configuration
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env` (it is in .gitignore).
#
# The system is designed to RUN WITH THIS FILE ENTIRELY UNCHANGED.
# Anything you leave blank degrades gracefully:
#   * no DATABASE_URL      -> embedded PGlite (real PostgreSQL 18 + pgvector)
#   * no OPENAI_API_KEY    -> deterministic local embeddings (demo quality)
#   * no ANTHROPIC_API_KEY -> extractive grounded answerer (quotes documents)
#   * no SaaS credentials  -> DRY-RUN: the exact outbound HTTP request is
#                             written to data/outbox/<service>.jsonl instead of
#                             being sent. Nothing is ever faked as "succeeded".
# =============================================================================

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info                        # debug | info | warn | error
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Shared secret required by internal tool endpoints (/api/tools/*) that n8n calls.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=
# HMAC-SHA256 secret used to sign/verify inbound webhooks (n8n, Vapi, Zapier).
WEBHOOK_SIGNING_SECRET=
# Comma-separated origins allowed to call the chat API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Max requests per minute per IP on public chat endpoints.
RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# PostgreSQL - structured relational system of record
# -----------------------------------------------------------------------------
# DB_DRIVER: pglite | postgres
#   pglite   = embedded PostgreSQL 18 (zero setup, used for the demo + tests)
#   postgres = external PostgreSQL via DATABASE_URL (production)
DB_DRIVER=pglite
PGLITE_DATA_DIR=./data/pglite
# Example: postgresql://urbancart:CHANGE_ME@localhost:5432/urbancart
DATABASE_URL=
PGSSL=false
PG_POOL_MAX=10

# -----------------------------------------------------------------------------
# Supabase - vector / embedding store for RAG
# -----------------------------------------------------------------------------
# VECTOR_STORE: auto | supabase | pgvector
#   auto     = supabase when credentials exist, otherwise local pgvector
#   supabase = force Supabase (RPC match_document_chunks)
#   pgvector = force the pgvector table in DB_DRIVER's database
VECTOR_STORE=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER: openai | local
#   local = deterministic hashed bag-of-words embedding. Real vector maths, but
#           far weaker recall than a trained model. Demo/offline only.
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Answer generation (LLM)
# -----------------------------------------------------------------------------
# LLM_PROVIDER: anthropic | openai | extractive
#   extractive = no LLM call. Answers are assembled verbatim from retrieved
#                chunks. Cannot hallucinate; reads more stiffly.
LLM_PROVIDER=extractive
ANTHROPIC_API_KEY=
# Default is Anthropic's most capable model. For high-volume support traffic
# `claude-sonnet-5` is a reasonable cost/quality trade-off - see docs/task-1
# section 28 (Cost considerations) before changing it.
ANTHROPIC_MODEL=claude-opus-5
LLM_MAX_TOKENS=700
# Effort controls thinking depth and spend on Claude 4.6+ models:
# low | medium | high | xhigh | max. Grounded RAG answers are short and
# well-specified, so `low` is the right setting here.
LLM_EFFORT=low
# Applies to the OpenAI path only. Sampling parameters (temperature/top_p) were
# removed on Claude Opus 5 and are rejected with a 400, so they are never sent.
LLM_TEMPERATURE=0.2

# -----------------------------------------------------------------------------
# RAG tuning
# -----------------------------------------------------------------------------
RAG_TOP_K=5
RAG_CHUNK_SIZE=900                    # characters per chunk (target)
RAG_CHUNK_OVERLAP=150
# Similarity thresholds. LEAVE THESE BLANK to use the provider-appropriate
# defaults - cosine scores are not comparable between embedding models
# (openai: 0.25 / 0.35, local: 0.08 / 0.22). Set them only to override.
# Retrieved chunks below this cosine similarity are discarded as irrelevant.
RAG_MIN_SIMILARITY=
# If grounding confidence is below this, the AI must NOT answer - it escalates.
RAG_CONFIDENCE_THRESHOLD=
KNOWLEDGE_BASE_DIR=./knowledge-base

# -----------------------------------------------------------------------------
# Business rules
# -----------------------------------------------------------------------------
# A lead at/above this PKR budget is "high value" and pages #sales in Slack.
HIGH_VALUE_LEAD_BUDGET_PKR=150000
HIGH_VALUE_LEAD_SCORE=70
# Window in which an identical customer+product lead is treated as a duplicate.
DUPLICATE_LEAD_WINDOW_HOURS=24

# -----------------------------------------------------------------------------
# Slack - selective internal notifications
# -----------------------------------------------------------------------------
# Either a bot token (chat.postMessage, preferred) or an incoming webhook URL.
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_SALES=#urbancart-sales
SLACK_CHANNEL_SUPPORT=#urbancart-support
SLACK_CHANNEL_ALERTS=#urbancart-alerts

# -----------------------------------------------------------------------------
# Airtable - operational interface for non-technical staff
# -----------------------------------------------------------------------------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_LEADS=Leads
AIRTABLE_TABLE_SUPPORT=Support Issues
AIRTABLE_TABLE_ORDERS=Orders

# -----------------------------------------------------------------------------
# Notion - internal documentation
# -----------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_VERSION=2022-06-28
# Page under which the "UrbanCart Internal Handbook" tree is created.
NOTION_PARENT_PAGE_ID=

# -----------------------------------------------------------------------------
# Google Drive - source document repository for RAG
# -----------------------------------------------------------------------------
# Path to a Google service-account JSON key with read access to the KB folder.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_POLL_MINUTES=15

# -----------------------------------------------------------------------------
# Zapier - cross-business automation (separate role from n8n)
# -----------------------------------------------------------------------------
# "Catch Hook" trigger URL of the UrbanCart high-value-lead Zap.
ZAPIER_CATCH_HOOK_URL=
ZAPIER_SHARED_SECRET=

# -----------------------------------------------------------------------------
# n8n - orchestration layer
# -----------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PREFIX=/webhook
# Sent by the backend to n8n and by n8n back to the backend (header auth).
N8N_SHARED_SECRET=

# -----------------------------------------------------------------------------
# Vapi - voice AI receptionist
# -----------------------------------------------------------------------------
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Value Vapi sends in the X-Vapi-Secret header on every server webhook.
VAPI_WEBHOOK_SECRET=
