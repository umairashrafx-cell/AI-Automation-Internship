{
  "name": "MATalogics Lead Management API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "create-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-create",
      "name": "Webhook - Create Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, -400],
      "webhookId": "create-lead"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst errors = [];\n\nif (!b.name || String(b.name).trim() === '') errors.push('name is required');\nif (!b.email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(b.email)) errors.push('valid email is required');\nif (!b.phone || String(b.phone).trim() === '') errors.push('phone is required');\n\nif (errors.length > 0) {\n  return [{ json: { valid: false, errors } }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    name: b.name,\n    email: b.email.toLowerCase().trim(),\n    phone: b.phone,\n    company: b.company || '',\n    interest: b.interest || '',\n    status: 'Active',\n    createdAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-validate",
      "name": "Validate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, -400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid",
      "name": "IF Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, -400]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "REPLACE_WITH_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Leads", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Phone": "={{ $json.phone }}",
            "Company": "={{ $json.company }}",
            "Interest": "={{ $json.interest }}",
            "Status": "={{ $json.status }}",
            "Created At": "={{ $json.createdAt }}"
          }
        },
        "options": {}
      },
      "id": "sheets-append",
      "name": "Google Sheets - Append Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, -460],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_WITH_CRED_ID", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"Lead created\", \"data\": { \"name\": $json.Name, \"email\": $json.Email, \"phone\": $json.Phone, \"company\": $json.Company, \"interest\": $json.Interest, \"createdAt\": $json[\"Created At\"] } } }}",
        "options": { "responseCode": 201 }
      },
      "id": "resp-create-ok",
      "name": "Respond - Lead Created",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, -460]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"errors\": $json.errors } }}",
        "options": { "responseCode": 400 }
      },
