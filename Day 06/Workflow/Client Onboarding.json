    {
      "parameters": {
        "jsCode": "const clients = $('Search records').all();\nconst ids = clients\n  .map(c => c.json.fields['Client ID'])\n  .filter(id => id && /^CL-\\d+$/.test(id))\n  .map(id => parseInt(id.split('-')[1], 10));\n\nconst nextNum = ids.length ? Math.max(...ids) + 1 : 1;\nconst nextId = `CL-${String(nextNum).padStart(3, '0')}`;\n\nreturn [{\n  json: {\n    newClientId: nextId,\n    triggerRecordId: $('Airtable Trigger').item.json.id,\n    name: $('Airtable Trigger').item.json.fields['Name'],\n    company: $('Airtable Trigger').item.json.fields['Company']\n  }\n}];"
