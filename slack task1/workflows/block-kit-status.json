{
  "blocks": [
    {
      "type": "header",
      "text": {
        "type": "plain_text",
        "text": "📊 Daily Project Status",
        "emoji": true
      }
    },
    {
      "type": "context",
      "elements": [
        {
          "type": "mrkdwn",
          "text": "Generated by n8n • {{ $now.format('dd LLL yyyy, HH:mm') }}"
        }
      ]
    },
    { "type": "divider" },
    {
      "type": "section",
      "fields": [
        { "type": "mrkdwn", "text": "*✅ Completed*\n{{ $json.completed }}" },
        { "type": "mrkdwn", "text": "*⏳ In progress*\n{{ $json.inProgress }}" },
        { "type": "mrkdwn", "text": "*⛔ Blocked*\n{{ $json.blocked }}" },
        { "type": "mrkdwn", "text": "*📅 Sprint*\nWeek 2 of 4" }
      ]
    },
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": "*Blocker:* {{ $json.blockerNote }}"
      }
    },
    {
      "type": "actions",
      "elements": [
        {
          "type": "button",
          "text": { "type": "plain_text", "text": "Open board", "emoji": true },
          "url": "https://example.com/board",
          "style": "primary"
        }
      ]
    }
  ]
}
